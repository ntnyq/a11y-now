{
  "name": "@a11y-now/monorepo",
  "version": "0.2.0",
  "private": true,
  "description": "Accessibility toolbar for any website: pluggable, themeable, framework-agnostic",
  "keywords": [
    "a11y",
    "accessibility",
    "toolbar",
    "wcag"
  ],
  "homepage": "https://github.com/ntnyq/a11y-now#readme",
  "bugs": {
    "url": "https://github.com/ntnyq/a11y-now/issues"
  },
  "license": "MIT",
  "author": {
    "name": "ntnyq",
    "email": "ntnyq13@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ntnyq/a11y-now.git"
  },
  "type": "module",
  "scripts": {
    "attw": "pnpm -r --filter './packages/*' --filter './packages-plugins/*' --filter './packages-themes/*' --filter './packages-frameworks/*' exec attw --pack . --profile esm-only",
    "build": "pnpm -r --filter './packages/*' --filter './packages-plugins/*' --filter './packages-themes/*' --filter './packages-frameworks/*' run build",
    "dev": "pnpm --filter @a11y-now/core run build --watch",
    "docs:build": "pnpm --filter docs run build",
    "docs:dev": "pnpm --filter docs run dev",
    "docs:preview": "pnpm --filter docs run preview",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "prepare": "husky",
    "publint": "pnpm -r --filter './packages/*' --filter './packages-plugins/*' --filter './packages-themes/*' --filter './packages-frameworks/*' exec publint --strict",
    "publish:new": "node scripts/publish-new-packages.mjs",
    "release": "run-s release:check release:version",
    "release:check": "run-s format:check lint typecheck build test publint attw",
    "release:version": "bumpp -r",
    "test": "vitest",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:coverage": "vitest --coverage",
    "trust:new": "node scripts/trust-new-packages.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@ntnyq/tsconfig": "^3.1.0",
    "@types/node": "^26.1.1",
    "@vitest/browser": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "bumpp": "^12.0.0",
    "happy-dom": "catalog:",
    "husky": "^9.1.7",
    "nano-staged": "^1.0.2",
    "npm-run-all2": "^9.0.2",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "playwright": "^1.62.0",
    "publint": "^0.3.22",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "nano-staged": {
    "*.{js,ts,mjs,tsx}": "oxlint --fix --no-error-on-unmatched-pattern",
    "*": "oxfmt --no-error-on-unmatched-pattern"
  },
  "packageManager": "pnpm@11.17.0"
}
