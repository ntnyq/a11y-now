{
  "name": "@a11y-now/react",
  "version": "0.1.0",
  "description": "a11y-now React integration: provider and hooks",
  "keywords": [
    "a11y",
    "accessibility",
    "react",
    "toolbar",
    "wcag"
  ],
  "homepage": "https://github.com/ntnyq/a11y-now#readme",
  "bugs": {
    "url": "https://github.com/ntnyq/a11y-now/issues"
  },
  "license": "MIT",
  "author": {
    "name": "ntnyq",
    "email": "ntnyq13@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ntnyq/a11y-now.git",
    "directory": "packages-frameworks/react"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown"
  },
  "dependencies": {
    "@a11y-now/core": "workspace:*",
    "@a11y-now/types": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  }
}
