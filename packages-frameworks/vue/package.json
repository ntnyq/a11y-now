{
  "name": "@a11y-now/vue",
  "version": "0.0.0",
  "description": "a11y-now Vue 3 integration: app plugin and composables",
  "keywords": [
    "a11y",
    "accessibility",
    "toolbar",
    "vue",
    "wcag"
  ],
  "homepage": "https://github.com/ntnyq/a11y-now#readme",
  "bugs": {
    "url": "https://github.com/ntnyq/a11y-now/issues"
  },
  "license": "MIT",
  "author": {
    "name": "ntnyq",
    "email": "ntnyq13@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ntnyq/a11y-now.git",
    "directory": "packages-frameworks/vue"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown"
  },
  "dependencies": {
    "@a11y-now/core": "workspace:*",
    "@a11y-now/types": "workspace:*"
  },
  "devDependencies": {
    "vue": "catalog:"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  }
}
