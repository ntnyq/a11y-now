{
  "name": "@a11y-now/nuxt",
  "version": "0.0.0",
  "description": "a11y-now nuxt module",
  "homepage": "https://github.com/ntnyq/a11y-now#readme",
  "bugs": {
    "url": "https://github.com/ntnyq/a11y-now/issues"
  },
  "license": "MIT",
  "author": {
    "name": "ntnyq",
    "email": "ntnyq13@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ntnyq/a11y-now.git",
    "directory": "packages-frameworks/nuxt"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/module.js",
  "types": "./dist/module.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/module.d.ts",
      "default": "./dist/module.js"
    },
    "./runtime/*": "./dist/runtime/*"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown"
  },
  "dependencies": {
    "@a11y-now/types": "workspace:*",
    "a11y-now": "workspace:*"
  }
}
