{
  "name": "a11y-now",
  "version": "0.1.0",
  "description": "Accessibility toolbar for any website: pluggable, themeable, framework-agnostic",
  "keywords": [
    "a11y",
    "accessibility",
    "screen-reader",
    "toolbar",
    "wcag"
  ],
  "homepage": "https://github.com/ntnyq/a11y-now#readme",
  "bugs": {
    "url": "https://github.com/ntnyq/a11y-now/issues"
  },
  "license": "MIT",
  "author": {
    "name": "ntnyq",
    "email": "ntnyq13@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ntnyq/a11y-now.git",
    "directory": "packages/a11y-now"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/a11y-now.iife.js",
  "jsdelivr": "./dist/a11y-now.iife.js",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./presets/*": {
      "types": "./dist/presets/*.d.ts",
      "default": "./dist/presets/*.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown"
  },
  "dependencies": {
    "@a11y-now/core": "workspace:*",
    "@a11y-now/plugin-big-cursor": "workspace:*",
    "@a11y-now/plugin-caption": "workspace:*",
    "@a11y-now/plugin-crosshair": "workspace:*",
    "@a11y-now/plugin-exit": "workspace:*",
    "@a11y-now/plugin-help": "workspace:*",
    "@a11y-now/plugin-pin": "workspace:*",
    "@a11y-now/plugin-region-nav": "workspace:*",
    "@a11y-now/plugin-reset": "workspace:*",
    "@a11y-now/plugin-screen-reader": "workspace:*",
    "@a11y-now/plugin-speech": "workspace:*",
    "@a11y-now/plugin-theme": "workspace:*",
    "@a11y-now/plugin-zoom": "workspace:*",
    "@a11y-now/theme-chocolate": "workspace:*",
    "@a11y-now/theme-deep-blue": "workspace:*",
    "@a11y-now/theme-default": "workspace:*",
    "@a11y-now/theme-forest": "workspace:*",
    "@a11y-now/theme-high-contrast": "workspace:*",
    "@a11y-now/types": "workspace:*"
  }
}
